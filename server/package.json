{
  "name": "clack-api",
  "version": "1.0.0",
  "private": true,
  "description": "Leaderboards, usernames and cross-device sync for Clack (Cloudflare Worker + D1)",
  "type": "module",
  "scripts": {
    "words": "node scripts/sync-words.mjs",
    "db:local": "wrangler d1 migrations apply clack --local",
    "db:remote": "wrangler d1 migrations apply clack --remote",
    "dev": "npm run words && npm run db:local && wrangler dev --port 8787",
    "site": "node scripts/serve-site.mjs",
    "test": "npm run words && node --test test/*.test.mjs",
    "deploy": "npm run words && npm run db:remote && wrangler deploy",
    "smoke": "node test/smoke.mjs https://clack-api.design-critic.workers.dev"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true
  }
}
